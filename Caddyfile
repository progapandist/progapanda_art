imgproxy.progapanda.org {
	reverse_proxy imgproxy:8080
}

# To host another site here: point its DNS at this droplet, add a block like this, and reload Caddy.
# A Kamal app must publish kamal-proxy on the private IP, because this Caddy holds 80/443:
#   kamal proxy boot_config set --publish-host-ip 10.114.0.2 --http-port 8090 --https-port 8453
