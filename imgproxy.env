IMGPROXY_LOCAL_FILESYSTEM_ROOT=/progapanda_art_sources
IMGPROXY_MAX_SRC_RESOLUTION=9999999
IMGPROXY_BASE_URL=local:///

# v4: internal result cache. The build only ever asks for a small fixed set
# of breakpoints (see imgproxy.js), so the hit rate here is high — this saves
# repeat resize/encode CPU on the same widths every visitor requests.
IMGPROXY_CACHE_USE=fs
IMGPROXY_CACHE_FS_ROOT=/imgproxy-cache

# Most browsers actually get AVIF (first <source> in the <picture>, see
# build.js) — this only affects the plain JPEG <img> fallback, but it's a
# real one-line win there: a coarse pass renders immediately instead of the
# image painting top-to-bottom as bytes arrive.
IMGPROXY_JPEG_PROGRESSIVE=true

# Default is 10s each. A large PNG (lossless, by far the slowest format to
# encode) from a big source, competing with other concurrent requests on
# this droplet's 2 vCPUs, legitimately took 10-18s end to end during cache
# warming — imgproxy finished the encode (status 200 in its own logs) but
# then hit its own write timeout sending the response, which read as a
# request failure even though the work completed and got cached anyway.
IMGPROXY_READ_TIMEOUT=30
IMGPROXY_WRITE_TIMEOUT=30

# IMGPROXY_KEY and IMGPROXY_SALT are secrets — set in .env (gitignored), not
# here, and passed through with `docker run -e IMGPROXY_KEY -e IMGPROXY_SALT`
# (see Makefile) rather than baked into this tracked file.
