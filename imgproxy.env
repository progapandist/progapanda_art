IMGPROXY_LOCAL_FILESYSTEM_ROOT=/progapanda_art_sources
IMGPROXY_MAX_SRC_RESOLUTION=9999999
IMGPROXY_BASE_URL=local:///

# NOTE: there is deliberately no IMGPROXY_CACHE_USE / IMGPROXY_CACHE_FS_ROOT
# here. Those looked like real options and imgproxy silently accepts them
# without complaint, but the internal result cache is a Pro-only feature —
# not present on this open-source build at all. Confirmed by testing: the
# exact same signed URL, fetched twice in a row, took the same ~2s both
# times, and /data/imgproxy-cache stayed empty throughout. Every request
# this image server ever serves is a full fresh encode — there is no
# origin-side caching, full stop. The only caching that actually helps is
# Cloudflare's edge cache in front of the public /i/ proxy (see
# functions/i/[[path]].js and warm.js) — anything that talks to imgproxy
# directly (including on the droplet's own Docker network) never touches it.

# Most browsers actually get AVIF (first <source> in the <picture>, see
# build.js) — this only affects the plain JPEG <img> fallback, but it's a
# real one-line win there: a coarse pass renders immediately instead of the
# image painting top-to-bottom as bytes arrive.
IMGPROXY_JPEG_PROGRESSIVE=true

# Default is 10s each. A large PNG (lossless, by far the slowest format to
# encode) from a big source, competing with other concurrent requests on
# this droplet's 2 vCPUs, legitimately took 10-18s end to end — imgproxy
# finished the encode (status 200 in its own logs) but then hit its own
# write timeout sending the response, which read as a request failure even
# though the work completed successfully.
IMGPROXY_READ_TIMEOUT=30
IMGPROXY_WRITE_TIMEOUT=30

# IMGPROXY_KEY and IMGPROXY_SALT are secrets — set in .env (gitignored), not
# here, and passed through with `docker run -e IMGPROXY_KEY -e IMGPROXY_SALT`
# (see Makefile) rather than baked into this tracked file.
